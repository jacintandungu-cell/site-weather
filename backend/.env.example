# Required in production: set these in Render's Environment dashboard.
# Never commit real secret values or place them in a production .env file.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///siteweather.db
OPENWEATHER_API_KEY=your_openweathermap_api_key